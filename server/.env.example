# Copia estos valores a tu entorno antes de iniciar el servidor.
# Genera un secreto propio con: openssl rand -hex 32
AUTH_SECRET=CAMBIA_ESTE_VALOR_POR_UN_SECRETO_ALEATORIO_LARGO

# Si el cliente se sirve desde otro host o puerto, agrega su origen separado por comas.
CLIENT_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

PORT=8080
MONGO_URI=mongodb://127.0.0.1:27017/sistemas_distribuidos_3d
